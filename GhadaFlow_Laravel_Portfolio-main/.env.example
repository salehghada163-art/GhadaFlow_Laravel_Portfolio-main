APP_NAME="GhadaFlow Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail / Contact Form (SMTP) — Outlook/Microsoft account
# Fill MAIL_PASSWORD in locally with a real Outlook App Password — never commit it.
MAIL_MAILER=smtp
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=ghadacareer75@outlook.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ghadacareer75@outlook.com"
MAIL_FROM_NAME="${APP_NAME}"

# Inbox that receives every Contact Form submission
MAIL_CONTACT_TO=ghadacareer75@outlook.com
